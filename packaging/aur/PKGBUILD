# Maintainer: Twongo <245470959+Tw0ngo@users.noreply.github.com>
pkgname=cuttycat-git
_pkgname=cuttycat
pkgver=0.1.0.r1.g3a3da3a
pkgrel=1
pkgdesc="Split a full album, DJ mix or playlist rip into tracks at the gaps"
arch=('any')
url="https://github.com/Tw0ngo/cuttycat"
license=('GPL-3.0-or-later')
depends=('python' 'pyside6' 'python-numpy' 'ffmpeg')
makedepends=('git' 'python-build' 'python-installer' 'python-setuptools' 'python-wheel')
checkdepends=('python-pytest')
optdepends=('yt-dlp: import audio from YouTube'
            'python-mutagen: covers in Opus and Ogg files')
provides=("$_pkgname")
conflicts=("$_pkgname")
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  printf "%s.r%s.g%s" \
    "$(sed -n 's/^__version__ = "\(.*\)"/\1/p' cuttycat/__init__.py)" \
    "$(git rev-list --count HEAD)" \
    "$(git rev-parse --short=7 HEAD)"
}

build() {
  cd "$_pkgname"
  python -m build --wheel --no-isolation
}

check() {
  cd "$_pkgname"
  python -m pytest -q tests
}

package() {
  cd "$_pkgname"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 cuttycat.desktop "$pkgdir/usr/share/applications/cuttycat.desktop"
  install -Dm644 cuttycat/assets/icon.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/cuttycat.png"
}
